<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<IsPackable>false</IsPackable>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="coverlet.collector" Version="6.0.4" />
		<PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
		<PackageReference Include="xunit" Version="2.9.3" />
		<PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
	</ItemGroup>

	<ItemGroup>
		<Using Include="Xunit" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\FON\FON.csproj" />
	</ItemGroup>

	<Target Name="CopyNativeLib"
	        AfterTargets="Build"
	        Condition="Exists('$(MSBuildThisFileDirectory)..\..\FON.Native\target\release\fon_native.dll')">
		<Copy SourceFiles="$(MSBuildThisFileDirectory)..\..\FON.Native\target\release\fon_native.dll"
		      DestinationFolder="$(OutputPath)"
		      SkipUnchangedFiles="true" />
	</Target>

</Project>