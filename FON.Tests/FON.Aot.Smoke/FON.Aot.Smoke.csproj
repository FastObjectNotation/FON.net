<Project Sdk="Microsoft.NET.Sdk">

	<!--
		Published with Native AOT to prove that generated record codecs need no reflection:
		dotnet publish FON.Tests/FON.Aot.Smoke -c Release -r win-x64
		The publish must show no IL2xxx or IL3xxx warning, and the executable must exit with 0.
	-->

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<IsPackable>false</IsPackable>
		<PublishAot>true</PublishAot>
		<InvariantGlobalization>true</InvariantGlobalization>
		<TrimmerSingleWarn>false</TrimmerSingleWarn>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\FON\FON.csproj" />
		<ProjectReference Include="..\..\FON.Generator\FON.Generator.csproj"
		                  OutputItemType="Analyzer"
		                  ReferenceOutputAssembly="false" />
	</ItemGroup>

</Project>
