<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<RootNamespace>FON</RootNamespace>
		<AssemblyName>FON</AssemblyName>
		<PackageId>FastObjectNotation</PackageId>
		<Title>FON — Fast Object Notation</Title>
		<PackageDescription>Fast Object Notation (FON) — high-performance, human-readable serialization for .NET, backed by a native core parallelized across CPU cores. Supports all primitive types, arrays, nested objects, and binary data. Requires a native runtime package (FastObjectNotation.Native or a platform-specific FastObjectNotation.Native.{rid}).</PackageDescription>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<Optimize>true</Optimize>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\FON.Native.Runtime\FON.Native.Runtime.csproj" />
	</ItemGroup>

</Project>
